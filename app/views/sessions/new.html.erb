<div class="min-h-screen bg-gray-900 text-white flex items-center justify-center p-4">
  <div class="bg-gray-800 rounded-lg p-8 w-full max-w-md">
    <h1 class="text-2xl font-bold mb-6">Login to Immigration Tracker</h1>

    <%= form_with url: login_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium mb-2" %>
        <%= f.email_field :email, required: true, autofocus: true, class: "w-full px-4 py-2 bg-gray-700 rounded-lg border border-gray-600 focus:border-blue-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium mb-2" %>
        <%= f.password_field :password, required: true, class: "w-full px-4 py-2 bg-gray-700 rounded-lg border border-gray-600 focus:border-blue-500 focus:outline-none" %>
      </div>

      <div>
        <%= f.submit "Login", class: "w-full bg-blue-600 hover:bg-blue-700 py-2 rounded-lg font-semibold cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 text-center text-sm">
      <span class="text-gray-400">Don't have an account?</span>
      <%= link_to "Sign up", signup_path, class: "text-blue-400 hover:underline ml-1" %>
    </div>
  </div>
</div>
